CAM_USER=admin
CAM_PASS=changeme
NOPARKING_CAM_IP=192.168.1.100
INTRUSION_CAM_IPS=192.168.1.101,192.168.1.102,192.168.1.103,192.168.1.104

# Login gate for the public-facing dashboard. Supports multiple accounts:
# comma-list both, paired by position (e.g. admin,staff / pass1,pass2).
PORTAL_USERNAME=admin
PORTAL_PASSWORD=changeme

# Optional overrides (defaults shown):
# WEB_PORT=8090
# CAM_PORT=20443
# RTSP_PORT=554
# PYTHON_BIN=python3
# FFMPEG_BIN=ffmpeg
# NVR_IP=192.168.1.200  (pulls real channel names from the NVR if set)
# NVR_USER / NVR_PASS default to CAM_USER / CAM_PASS above
# SESSION_SECRET=... (auto-generated + persisted to .session-secret if unset)
